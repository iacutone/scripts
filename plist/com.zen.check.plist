<?xml version="1.0" encoding="UTF-8"?>
<!--
Per-user LaunchAgent (not a root daemon) so macOS notifications reach your session.
Install:
  cp plist/com.zen.check.plist ~/Library/LaunchAgents/
  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.zen.check.plist
Remove:
  launchctl bootout gui/$(id -u)/com.zen.check && rm ~/Library/LaunchAgents/com.zen.check.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.zen.check</string>
    <key>ProgramArguments</key>
    <array>
      <string>/opt/homebrew/bin/python3</string>
      <string>/Users/ericiacutone/scripts/zen/check_zen.py</string>
      <string>--quiet</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/ericiacutone/Library/Logs/zen-check.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ericiacutone/Library/Logs/zen-check.log</string>
  </dict>
</plist>
