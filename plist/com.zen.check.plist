<?xml version="1.0" encoding="UTF-8"?>
<!--
Per-user LaunchAgent (not a root daemon) so macOS notifications reach your session.
This is a template: the python, repo and home placeholders are filled in by the installer.
Install:
  zen/install.sh
Remove:
  launchctl bootout gui/$(id -u)/com.zen.check && rm ~/Library/LaunchAgents/com.zen.check.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.zen.check</string>
    <key>ProgramArguments</key>
    <array>
      <string>__PYTHON__</string>
      <string>__REPO__/zen/check_zen.py</string>
      <string>--quiet</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/zen-check.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/zen-check.log</string>
  </dict>
</plist>
